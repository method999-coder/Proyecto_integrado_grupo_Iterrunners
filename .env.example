# =========================
# Django base
# =========================
# Desarrollo: True | Producción: False
DEBUG=True

# Obligatorio en producción
SECRET_KEY=change-me-with-a-long-random-secret

# Hosts y CSRF (separados por coma)
# Ejemplo prod: ALLOWED_HOSTS=app.tudominio.com
ALLOWED_HOSTS=127.0.0.1,localhost
# Ejemplo prod: CSRF_TRUSTED_ORIGINS=https://app.tudominio.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# =========================
# Base de datos
# =========================
# INICIO - Base de datos de Iterrunners-Dev
# Esta copia usa db.sqlite3 en la raíz e ignora DATABASE_URL.
# FIN - Base de datos de Iterrunners-Dev

# =========================
# Strava OAuth
# =========================
# INICIO - Habilitar Strava solo para pruebas autorizadas
STRAVA_ENABLED=False
# Usar credenciales de la aplicación de pruebas si se habilita.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# FIN - Habilitar Strava solo para pruebas autorizadas

# Desarrollo local
STRAVA_REDIRECT_URI=http://127.0.0.1:8000/strava/callback/
# Producción (debe ser HTTPS)
# STRAVA_REDIRECT_URI=https://app.tudominio.com/strava/callback/

# =========================
# Seguridad HTTPS (producción)
# =========================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# =========================
# Logging
# =========================
# DEBUG=True recomendado: INFO
# Producción recomendado: WARNING
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
